{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.dev/agentic-qe/validation-plan.schema.json",
  "title": "Agentic QE Validation Plan",
  "type": "object",
  "required": ["objective", "risk_coverage", "differential_testing", "human_release_approval", "evidence", "scenarios", "requested_tools", "rationale", "generated_by"],
  "properties": {
    "objective": {"type": "string", "minLength": 1},
    "risk_coverage": {"type": "array", "items": {"type": "string"}},
    "differential_testing": {"type": "boolean"},
    "human_release_approval": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "requested_tools": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "generated_by": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "assertion", "expected", "priority", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "assertion": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "priority": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
